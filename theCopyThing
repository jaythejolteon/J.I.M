<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>RIFT//ARENA — Fighter Forge</title>
<style>
:root{--bg:#090b13;--panel:#131827;--panel2:#1b2335;--line:#303b56;--text:#eef3ff;--muted:#9aa8c4;--gold:#ffc857;--cyan:#5ee7ff;--pink:#ff5d9e;--green:#7cf0b2}
*{box-sizing:border-box}body{margin:0;background:radial-gradient(ellipse at 50% -10%,#27365a 0,#101525 38%,var(--bg) 75%);color:var(--text);font:15px/1.45 system-ui,-apple-system,Segoe UI,sans-serif}
header{padding:22px clamp(16px,4vw,48px);border-bottom:1px solid #29334a;display:flex;justify-content:space-between;align-items:center;gap:16px;flex-wrap:wrap}
.logo{font-weight:1000;letter-spacing:.14em;font-size:clamp(20px,3vw,30px)}.logo span{color:var(--cyan)}.tag{color:var(--muted);font-size:12px;letter-spacing:.18em}
main{max-width:1250px;margin:auto;padding:24px clamp(14px,3vw,32px) 60px}
nav{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:20px}.tab,button{border:1px solid var(--line);background:var(--panel2);color:var(--text);padding:10px 14px;border-radius:10px;font-weight:750;cursor:pointer}.tab.active{background:var(--cyan);color:#061018;border-color:var(--cyan)}button:hover,.tab:hover{filter:brightness(1.15)}button.primary{background:linear-gradient(110deg,#ffe08b,#ffae45);color:#211505;border:0}button.danger{border-color:#84425e;color:#ff9bbb}button:disabled{opacity:.4;cursor:not-allowed}
.panel{background:linear-gradient(145deg,#171f31ee,#101624ee);border:1px solid var(--line);border-radius:17px;padding:20px;box-shadow:0 14px 45px #0004}.hidden{display:none!important}
h1,h2,h3,p{margin-top:0}h1{font-size:clamp(25px,4vw,40px);line-height:1.05;margin-bottom:8px}h2{font-size:22px}h3{font-size:16px;margin-bottom:8px}.muted,.hint{color:var(--muted)}.hint{font-size:12px}
.layout{display:grid;grid-template-columns:minmax(0,1.15fr) minmax(280px,.85fr);gap:18px}.fields{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.field{display:flex;flex-direction:column;gap:6px}.field.full{grid-column:1/-1}label{font-size:12px;color:#b7c4df;font-weight:800;letter-spacing:.04em}input,select,textarea{width:100%;background:#0b1120;color:var(--text);border:1px solid var(--line);border-radius:9px;padding:11px;font:inherit}input[type=color]{height:43px;padding:4px}input[type=range]{padding:0;accent-color:var(--cyan)}.actions{display:flex;gap:8px;flex-wrap:wrap;margin-top:15px}
.fighter-preview{min-height:400px;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;overflow:hidden;position:relative;background:radial-gradient(circle at 50% 40%,#34456d 0,#151c2d 50%,#0c111e 100%)}
.avatar{width:180px;height:240px;position:relative;display:flex;align-items:center;justify-content:center;filter:drop-shadow(0 18px 22px #0009)}
.avatar .body{width:110px;height:150px;margin-top:70px;border-radius:45% 45% 18% 18%;background:var(--suit);border:5px solid #0a0d16;position:absolute}
.avatar .head{width:83px;height:94px;border-radius:44% 44% 42% 42%;background:var(--skin);position:absolute;top:25px;border:4px solid #0a0d16;z-index:2}
.avatar .hair{position:absolute;z-index:3;top:9px;width:94px;height:50px;background:var(--hair);border-radius:60% 50% 25% 25%;clip-path:polygon(0 60%,8% 10%,30% 22%,42% 0,62% 20%,90% 5%,100% 70%,80% 55%,70% 100%,48% 62%,28% 100%,17% 60%)}
.avatar .eyes{position:absolute;top:61px;z-index:4;font-size:22px;letter-spacing:14px;margin-left:13px;color:#121827}
.avatar .belt{position:absolute;z-index:4;top:174px;width:112px;height:10px;background:var(--accent);border:2px solid #0a0d16}
.avatar .aura{position:absolute;inset:0;border-radius:50%;background:radial-gradient(ellipse,#fff2 0,transparent 65%);animation:pulse 2s infinite}
@keyframes pulse{50%{transform:scale(1.12);opacity:.5}}
.stat{display:flex;align-items:center;gap:9px;margin:9px 0}.stat span{width:82px;color:var(--muted);font-size:12px}.bar{height:8px;background:#080d18;border-radius:9px;flex:1;overflow:hidden}.bar i{display:block;height:100%;background:linear-gradient(90deg,var(--cyan),#a6ffe3);border-radius:9px}
.cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(210px,1fr));gap:12px}.fighter-card{cursor:pointer;border:1px solid var(--line);border-radius:13px;padding:14px;background:#111a2a}.fighter-card.selected{border-color:var(--gold);box-shadow:0 0 0 1px var(--gold)}.portrait{height:105px;border-radius:10px;margin-bottom:10px;display:grid;place-items:center;font-size:48px;background:linear-gradient(135deg,#273a5c,#121827)}
.arena-hero{padding:20px;border-radius:14px;background:linear-gradient(120deg,#26324c,#151b2a);border:1px solid var(--line);margin-bottom:14px}.arena-hero strong{color:var(--gold)}
.battle{display:grid;grid-template-columns:1fr 1fr;gap:12px}.combatant{background:#0b1120;border:1px solid var(--line);border-radius:12px;padding:14px}.health{height:12px;background:#273047;border-radius:8px;overflow:hidden;margin:8px 0}.health i{display:block;height:100%;background:linear-gradient(90deg,#ff647e,#ffc15e);transition:width .3s}.energy{height:7px;background:#273047;border-radius:8px;overflow:hidden}.energy i{display:block;height:100%;background:var(--cyan)}.log{height:165px;overflow:auto;background:#080d17;border:1px solid var(--line);padding:12px;border-radius:10px;font-size:13px;color:#c5d2eb}.log p{margin:0 0 7px}.reward{border:1px solid #65532c;background:#2a2417;padding:12px;border-radius:10px;color:#ffe3a0}
footer{margin-top:28px;text-align:center;color:#7786a3;font-size:12px}
@media(max-width:760px){.layout{grid-template-columns:1fr}.fields{grid-template-columns:1fr 1fr}.fighter-preview{min-height:330px}}@media(max-width:420px){.fields{grid-template-columns:1fr}.battle{grid-template-columns:1fr}}
</style>
</head>
<body>
<header><div><div class="logo">RIFT<span>//</span>ARENA</div><div class="tag">FORGE YOUR FIGHTER. OWN THE RIFT.</div></div><div class="tag">SEASON 01 · BUILD 0.1</div></header>
<main>
<nav>
<button class="tab active" data-tab="forge">01 · FIGHTER FORGE</button>
<button class="tab" data-tab="select">02 · SELECT</button>
<button class="tab" data-tab="arena">03 · ARENA</button>
<button class="tab" data-tab="tournament">04 · TOURNAMENTS</button>
<button class="tab" data-tab="rewards">05 · TROPHY ROOM</button>
</nav>
<section id="forge" class="page">
<h1>Build your legend.</h1><p class="muted">Design an original combatant, invent their style, and give them a signature power.</p>
<div class="layout">
<div class="panel">
<h2>Character creator</h2>
<div class="fields">
<div class="field"><label>FIGHTER NAME</label><input id="name" maxlength="22" value="Nova Vex"></div>
<div class="field"><label>FIGHTING STYLE NAME</label><input id="style" maxlength="28" value="Solar Breaker"></div>
<div class="field"><label>FACE / SKIN TONE</label><select id="skin"><option value="#9b6549">Warm bronze</option><option value="#f0c7a2">Porcelain</option><option value="#75452f">Deep umber</option><option value="#d99b78">Copper</option><option value="#b9c6d8">Moonlit</option></select></div>
<div class="field"><label>HAIRSTYLE</label><select id="hairStyle"><option>Wild spikes</option><option>Long flow</option><option>Undercut</option><option>Top knot</option><option>Hooded</option></select></div>
<div class="field"><label>HAIR COLOR</label><input id="hair" type="color" value="#f5bd4f"></div>
<div class="field"><label>OUTFIT / ARMOR</label><select id="outfit"><option>Rift armor</option><option>Street combat</option><option>Temple robes</option><option>Cybernetic suit</option><option>Wasteland gear</option></select></div>
<div class="field"><label>OUTFIT COLOR</label><input id="suit" type="color" value="#293e72"></div>
<div class="field"><label>ENERGY COLOR</label><input id="accent" type="color" value="#ffc857"></div>
<div class="field"><label>ACCESSORY</label><select id="accessory"><option>Arc visor</option><option>Spirit scarf</option><option>Shoulder mantle</option><option>Tech gauntlets</option><option>Ancient amulet</option><option>None</option></select></div>
<div class="field"><label>SIGNATURE ABILITY</label><select id="ability"><option>Solar Flare</option><option>Dark Aura</option><option>Phantom Rush</option><option>Dimension Shift</option><option>Storm Fist</option><option>Inferno Kick</option></select></div>
<div class="field"><label>POWER LEVEL</label><input id="power" type="range" min="1" max="10" value="7"><span class="hint" id="powerVal">7 / 10</span></div>
<div class="field"><label>FIGHTER ROLE</label><select id="role"><option>Balanced</option><option>Striker</option><option>Speedster</option><option>Tank</option><option>Trickster</option></select></div>
</div>
<div class="actions"><button class="primary" id="save">Save fighter</button><button id="random">Randomize design</button></div>
<p class="hint">Your design is rendered as a stylized preview. Saved fighters stay in this game session.</p>
</div>
<div class="panel fighter-preview">
<div class="avatar" id="avatar"><div class="aura"></div><div class="body"></div><div class="head"></div><div class="hair"></div><div class="eyes">• •</div><div class="belt"></div></div>
<h2 id="previewName">NOVA VEX</h2><div class="muted" id="previewStyle">Solar Breaker · Rift armor</div>
<p id="previewMeta" class="hint">Arc visor · Solar Flare</p>
<div style="width:100%;max-width:290px;text-align:left" id="previewStats"></div>
</div>
</div></section>
<section id="select" class="page hidden">
<h1>Choose your fighter.</h1><p class="muted">Select a combatant to take into the arena.</p><div class="cards" id="roster"></div>
</section>
<section id="arena" class="page hidden">
<h1>Enter the arena.</h1><p class="muted">A quick arcade duel against an adaptive boss. Special moves consume energy.</p>
<div class="arena-hero"><div class="field"><label>FIGHTING LOCATION</label><select id="location"><option>Neon City Rooftops</option><option>Underground Fight Gym</option><option>Sunken Temple</option><option>Blackglass Beach</option><option>Abandoned Factory</option><option>Luxury Hotel Rooftop</option><option>Cyberpunk Megacity</option><option>Underworld Citadel</option></select></div><p class="hint" id="arenaDesc">A storm of neon lights and rain-slick rooftops.</p></div>
<div class="battle">
<div class="combatant"><h3 id="playerLabel">YOUR FIGHTER</h3><div class="health"><i id="playerHp" style="width:100%"></i></div><div class="hint" id="playerHealth">100 / 100 HP</div><div class="energy"><i id="playerEnergy" style="width:35%"></i></div><div class="hint" id="playerEnergyText">35 / 100 energy</div></div>
<div class="combatant"><h3 id="bossLabel">RIFT WARDEN · BOSS</h3><div class="health"><i id="bossHp" style="width:100%"></i></div><div class="hint" id="bossHealth">140 / 140 HP</div><div class="energy"><i id="bossEnergy" style="width:100%"></i></div><div class="hint">Boss energy</div></div>
</div>
<div class="panel" style="margin-top:12px"><div class="actions" style="margin-top:0"><button class="primary" id="attack">Quick strike</button><button id="special">Signature ability</button><button id="guard">Guard + recharge</button><button class="danger" id="restart">New boss battle</button></div><p class="hint" style="margin:10px 0 0">Boss instinct: repeating the same move makes it adapt and counter harder. Win by reducing boss HP to zero.</p><div class="log" id="log" style="margin-top:12px"><p>The Rift Warden steps forward. Choose your opening move.</p></div></div>
</section>
<section id="tournament" class="page hidden">
<h1>Championship circuit.</h1><p class="muted">Three event formats. Each victory adds to your career record.</p>
<div class="cards">
<div class="panel"><h3>World Championship</h3><p class="muted">A best-of-one title fight against the reigning champion.</p><button onclick="startTournament('World Championship')">Enter championship</button></div>
<div class="panel"><h3>Galactic Championship</h3><p class="muted">Face challengers from distant planets and strange arenas.</p><button onclick="startTournament('Galactic Championship')">Enter galactic cup</button></div>
<div class="panel"><h3>Survival Championship</h3><p class="muted">Three consecutive rounds. Your health carries over with limited recovery.</p><button onclick="startTournament('Survival Championship')">Enter survival</button></div>
</div>
<div class="panel" style="margin-top:14px"><h2 id="tourTitle">No active tournament</h2><p id="tourInfo" class="muted">Choose an event to generate your match card.</p><div id="tourMatch" class="reward hidden"></div><div class="actions"><button id="tourFight" class="primary" disabled>Fight next round</button></div></div>
</section>
<section id="rewards" class="page hidden">
<h1>Trophy room.</h1><p class="muted">Your victories, titles, and championship history.</p>
<div class="cards" id="trophies"></div>
<div class="panel" style="margin-top:14px"><h2>Career record</h2><div id="record" class="muted"></div></div>
</section>
<footer>RIFT//ARENA · Original browser prototype · Progress lasts while this page session remains open</footer>
</main>
<script>
const $=id=>document.getElementById(id);
const defaults=[
{name:"Nova Vex",style:"Solar Breaker",ability:"Solar Flare",outfit:"Rift armor",role:"Balanced",skin:"#9b6549",hair:"#f5bd4f",suit:"#293e72",accent:"#ffc857",accessory:"Arc visor",power:7},
{name:"Kairo Flux",style:"Phantom Current",ability:"Phantom Rush",outfit:"Cybernetic suit",role:"Speedster",skin:"#d99b78",hair:"#54d8df",suit:"#263b42",accent:"#5ee7ff",accessory:"Tech gauntlets",power:8},
{name:"Morrow Hex",style:"Abyssal Grasp",ability:"Dark Aura",outfit:"Wasteland gear",role:"Tank",skin:"#75452f",hair:"#d6d0e8",suit:"#38213f",accent:"#b58cff",accessory:"Ancient amulet",power:9}
];
let roster=defaults.map(x=>({...x})), selected=0, player={hp:100,energy:35}, boss={hp:140,max:140,energy:100},lastMove="",repeat=0,guarding=false, wins=0,streak=0,bossesDefeated=0,worldWins=0,tournament=null,round=0,tourHealth=100;
const names=["Vanta Prime","Ember Saint","Orion Null","Queen Caldera","The Pale Engine","Astra Khan"];
const locations={
"Neon City Rooftops":"A storm of neon lights and rain-slick rooftops.",
"Underground Fight Gym":"Concrete walls, roaring crowds, and old-school grit.",
"Sunken Temple":"Ancient stonework hums with dormant energy.",
"Blackglass Beach":"Moonlit waves crash against volcanic glass.",
"Abandoned Factory":"Rusting machinery and sparks fill the air.",
"Luxury Hotel Rooftop":"A skyline view above a glittering city.",
"Cyberpunk Megacity":"Holograms flicker beneath towering megastructures.",
"Underworld Citadel":"Dark architecture rises over a supernatural abyss."
};
function current(){return roster[selected]||roster[0]}
function statBars(f){let p=Number(f.power)||5;let vals={Power:p*10,Speed:f.role==="Speedster"?95:f.role==="Tank"?45:70,Defense:f.role==="Tank"?95:f.role==="Striker"?55:70,Skill:f.role==="Trickster"?95:75};return Object.entries(vals).map(([k,v])=>`<div class="stat"><span>${k}</span><div class="bar"><i style="width:${v}%"></i></div></div>`).join("")}
function renderPreview(){let f=currentForm();$("previewName").textContent=f.name.toUpperCase();$("previewStyle").textContent=f.style+" · "+f.outfit;$("previewMeta").textContent=f.accessory+" · "+f.ability;$("avatar").style.setProperty("--skin",f.skin);$("avatar").style.setProperty("--hair",f.hair);$("avatar").style.setProperty("--suit",f.suit);$("avatar").style.setProperty("--accent",f.accent);$("previewStats").innerHTML=statBars(f);$("powerVal").textContent=$("power").value+" / 10"}
function currentForm(){return {name:$("name").value||"Unnamed Fighter",style:$("style").value||"Unwritten Style",skin:$("skin").value,hair:$("hair").value,suit:$("suit").value,accent:$("accent").value,outfit:$("outfit").value,accessory:$("accessory").value,ability:$("ability").value,power:$("power").value,role:$("role").value}}
["name","style","skin","hair","suit","accent","outfit","accessory","ability","power","role"].forEach(id=>$(id).addEventListener("input",renderPreview));
$("save").onclick=()=>{let f=currentForm();let i=roster.findIndex(x=>x.name===f.name);if(i>=0){roster[i]=f;selected=i}else{roster.push(f);selected=roster.length-1}renderRoster();renderPreview();$("save").textContent="Saved ✓";setTimeout(()=>$("save").textContent="Save fighter",1000)};
$("random").onclick=()=>{let pick=(id,arr)=>$(id).value=arr[Math.floor(Math.random()*arr.length)];pick("skin",["#9b6549","#f0c7a2","#75452f","#d99b78","#b9c6d8"]);pick("hair",["#f5bd4f","#54d8df","#d6d0e8","#f46f9b","#3c315f"]);pick("suit",["#293e72","#263b42","#38213f","#713d2e","#1f2939"]);pick("accent",["#ffc857","#5ee7ff","#b58cff","#ff5d9e","#7cf0b2"]);pick("outfit",["Rift armor","Street combat","Temple robes","Cybernetic suit","Wasteland gear"]);pick("accessory",["Arc visor","Spirit scarf","Shoulder mantle","Tech gauntlets","Ancient amulet"]);pick("ability",["Solar Flare","Dark Aura","Phantom Rush","Dimension Shift","Storm Fist","Inferno Kick"]);pick("role",["Balanced","Striker","Speedster","Tank","Trickster"]);$("name").value=["Solar Wraith","Echo Zenith","Riven Star","Nyx Voltage"][Math.floor(Math.random()*4)];$("style").value=["Comet Fang","Voidstep Art","Thunder Bloom","Rift Requiem"][Math.floor(Math.random()*4)];$("power").value=5+Math.floor(Math.random()*6);renderPreview()};
function renderRoster(){$("roster").innerHTML=roster.map((f,i)=>`<div class="fighter-card ${i===selected?"selected":""}" data-i="${i}"><div class="portrait">${["⚡","☄️","🌑","🌀","🔥","✦"][i%6]}</div><h3>${esc(f.name)}</h3><div class="hint">${esc(f.style)} · ${esc(f.role)}</div><p class="hint">${esc(f.ability)} · Power ${f.power}/10</p></div>`).join("");document.querySelectorAll(".fighter-card").forEach(c=>c.onclick=()=>{selected=+c.dataset.i;renderRoster();let f=current();Object.keys(f).forEach(k=>{if($(k))$(k).value=f[k]});renderPreview()})}
function esc(s){return String(s).replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]))}
document.querySelectorAll(".tab").forEach(b=>b.onclick=()=>{document.querySelectorAll(".tab").forEach(x=>x.classList.toggle("active",x===b));document.querySelectorAll(".page").forEach(x=>x.classList.toggle("hidden",x.id!==b.dataset.tab));if(b.dataset.tab==="rewards")renderRewards();if(b.dataset.tab==="select")renderRoster()});
$("location").onchange=()=>{$("arenaDesc").textContent=locations[$("location").value]};
function log(t){let p=document.createElement("p");p.textContent=t;$("log").appendChild(p);$("log").scrollTop=$("log").scrollHeight}
function updateBattle(){$("playerHp").style.width=Math.max(0,player.hp)+"%";$("playerHealth").textContent=Math.max(0,player.hp)+" / 100 HP";$("playerEnergy").style.width=player.energy+"%";$("playerEnergyText").textContent=player.energy+" / 100 energy";$("bossHp").style.width=Math.max(0,boss.hp/boss.max*100)+"%";$("bossHealth").textContent=Math.max(0,boss.hp)+" / "+boss.max+" HP";$("bossEnergy").style.width=boss.energy+"%";$("playerLabel").textContent=current().name.toUpperCase()}
function resetBattle(){player={hp:100,energy:35};boss={hp:140,max:140,energy:100};lastMove="";repeat=0;guarding=false;bossAwakened=false;activeBoss=bossRoster.find(n=>!defeatedBosses.has(n))||bossRoster[Math.floor(Math.random()*bossRoster.length)];$("bossLabel").textContent=activeBoss.toUpperCase()+" · BOSS";$("log").innerHTML="<p>"+activeBoss+" enters the arena. Make your move.</p>";updateBattle()}
function enemyTurn(){if(boss.hp<=0||player.hp<=0)return;let dmg=12+Math.floor(Math.random()*9);if(repeat>=2){dmg+=10;log("Boss instinct activated: it read your repeated pattern and found an opening!")}if(Math.random()<.14){log(activeBoss+" summons temporary clones. A phantom strike slips through!");dmg+=8}if(boss.hp<=boss.max*.5&&!bossAwakened){bossAwakened=true;log(activeBoss+" triggers DIVINE AWAKENING! Its legendary form surges with power.");boss.energy=100}if(bossAwakened&&Math.random()<.35){dmg+=12;log("Awakened boss form fires a devastating divine blast!")}if(boss.energy>=35&&Math.random()<.28){boss.energy-=30;dmg+=13;log(activeBoss+" unleashes a Rift Surge!") }if(guarding)dmg=Math.max(3,Math.floor(dmg*.25));player.hp=Math.max(0,player.hp-dmg);guarding=false;log("The boss counters for "+dmg+" damage.");if(player.hp<=0)log("Defeat. Regroup and challenge the boss again.");updateBattle()}
function winBattle(){boss.hp=0;updateBattle();log("VICTORY! "+current().name+" claims the arena.");bossesDefeated++;defeatedBosses.add(activeBoss);if(defeatedBosses.size===bossRoster.length)log("BOSS SLAYER TITLE UNLOCKED — every boss defeated!");if(tournament){round++;if(tournament==="Survival Championship"&&round<3){tourHealth=Math.max(35,player.hp+20);$("tourInfo").textContent="Round "+(round+1)+" of 3. Limited recovery restored you to "+tourHealth+" HP."; $("tourMatch").textContent="Next challenger: "+names[(round+1)%names.length];$("tourFight").disabled=false}else{finishTournament()}}}
function action(move){if(player.hp<=0||boss.hp<=0)return;let f=current(),dmg=0;if(move==="attack"){dmg=10+Math.floor(Math.random()*8);player.energy=Math.min(100,player.energy+10);log(f.name+" lands a quick strike for "+dmg+" damage.")}else if(move==="special"){if(player.energy<35){log("Not enough energy! Guard to recharge.");return}player.energy-=35;let power=Number(f.power)||5;dmg=22+power*4+Math.floor(Math.random()*10);let desc={"Solar Flare":"a bright golden solar blast","Dark Aura":"a crushing dark aura","Phantom Rush":"a rapid rush of glowing afterimages","Dimension Shift":"a portal-shifting strike","Storm Fist":"an electric storm punch","Inferno Kick":"a blazing inferno kick"}[f.ability]||f.ability;log(f.name+" unleashes "+f.ability+": "+desc+"! "+dmg+" damage.")}else{guarding=true;player.energy=Math.min(100,player.energy+28);log(f.name+" guards, braces for impact, and recharges 28 energy.");}
if(move!=="guard"){if(lastMove===move)repeat++;else repeat=1;lastMove=move;boss.hp=Math.max(0,boss.hp-dmg)}else{lastMove="guard";repeat=0}if(boss.hp<=0){winBattle();return}enemyTurn()}
$("attack").onclick=()=>action("attack");$("special").onclick=()=>action("special");$("guard").onclick=()=>action("guard");$("restart").onclick=resetBattle;
function startTournament(type){tournament=type;round=0;tourHealth=100;$("tourTitle").textContent=type;$("tourInfo").textContent=type==="Survival Championship"?"Three rounds. Health carries over with a small recovery between fights.":"Defeat the challenger to claim the tournament victory.";$("tourMatch").classList.remove("hidden");$("tourMatch").textContent="Round 1 · "+names[Math.floor(Math.random()*names.length)]+" awaits."; $("tourFight").disabled=false}
$("tourFight").onclick=()=>{document.querySelector('[data-tab="arena"]').click();resetBattle();player.hp=tourHealth;boss.max=tournament==="Survival Championship"?125:155;boss.hp=boss.max;updateBattle();$("log").innerHTML="<p>Tournament round "+(round+1)+" begins! Defeat the challenger, then return to the tournament panel.</p>";$("log").appendChild(document.createElement("p")).textContent="Your tournament progress will update when you win."};
function finishTournament(){let t=tournament;log(t+" completed!");wins++;streak++;if(streak>=3)log("Three tournament wins in a row: Silver Champion Trophy unlocked!");if(t==="World Championship"){worldWins++;} $("tourInfo").textContent=t+" won!";$("tourMatch").textContent="CHAMPION · "+current().name+" wins the "+t+"!";$("tourFight").disabled=true;tournament=null}
function renderRewards(){let items=[["🥉","Bronze Champion Trophy",wins>=1,"First tournament win"],["🥈","Silver Champion Trophy",streak>=3,"Three tournament wins in a row"],["☠️","Boss Slayer",defeatedBosses.size===bossRoster.length,"Defeat every unique boss"],["🏆","World Champion Belt",worldWins>=1,"Win the World Championship"]];$("trophies").innerHTML=items.map(([icon,name,earned,desc])=>`<div class="panel"><div style="font-size:40px">${icon}</div><h3>${name}</h3><p class="hint">${desc}</p><strong style="color:${earned?"#7cf0b2":"#8b96ac"}">${earned?"UNLOCKED":"LOCKED"}</strong></div>`).join("");$("record").textContent=`Tournament wins: ${wins} · Consecutive tournament wins: ${streak} · Unique bosses defeated: ${defeatedBosses.size}/${bossRoster.length} · World titles: ${worldWins}`}
renderPreview();renderRoster();resetBattle();renderRewards();
</script>
</body></html>
